{
  "datasets": [
    {
      "name": "1895cb3e",
      "displayName": "headline",
      "queryLines": [
        "-- Headline numbers for the top of the dashboard\r\n",
        "SELECT COUNT(*)                                   AS contracts,\r\n",
        "       ROUND(SUM(total_amount_usd) / 1e6, 1)      AS contracted_usd_millions,\r\n",
        "       (SELECT median(tender_days) FROM procintel.gold.tender_training WHERE is_valid_label) AS median_tender_days\r\n",
        "FROM procintel.silver.contracts;"
      ]
    },
    {
      "name": "b77184dd",
      "displayName": "value_by_year",
      "queryLines": [
        "-- Contract value per year, split by category (works / goods / consulting / non-consulting)\r\n",
        "SELECT year(signing_date)                    AS signing_year,\r\n",
        "       procurement_group,\r\n",
        "       ROUND(SUM(total_amount_usd) / 1e6, 2)  AS usd_millions\r\n",
        "FROM procintel.silver.contracts\r\n",
        "WHERE signing_date IS NOT NULL\r\n",
        "GROUP BY ALL\r\n",
        "ORDER BY signing_year;"
      ]
    },
    {
      "name": "d0fe479e",
      "displayName": "tender_speed_by_method",
      "queryLines": [
        "-- How long does each procurement method take? (valid labels only)\r\n",
        "SELECT procurement_method,\r\n",
        "       COUNT(*)            AS tenders,\r\n",
        "       median(tender_days) AS median_days\r\n",
        "FROM procintel.gold.tender_training\r\n",
        "WHERE is_valid_label\r\n",
        "GROUP BY procurement_method\r\n",
        "HAVING COUNT(*) >= 10          -- hide methods with too few examples to trust\r\n",
        "ORDER BY median_days DESC;"
      ]
    },
    {
      "name": "90d303f7",
      "displayName": "governance_trend",
      "queryLines": [
        "-- Kenya's governance scores over time (context for procurement risk)\r\n",
        "SELECT year, indicator_name, score\r\n",
        "FROM procintel.silver.governance_indicators\r\n",
        "WHERE year >= 2005\r\n",
        "ORDER BY year;"
      ]
    },
    {
      "name": "8ff98ae3",
      "displayName": "top_suppliers",
      "queryLines": [
        "-- Top 15 suppliers by awarded value (names normalised; column tagged PII)\r\n",
        "SELECT example_name AS supplier, n_contracts, n_projects,\r\n",
        "       ROUND(total_awarded_usd / 1e6, 2) AS awarded_usd_millions\r\n",
        "FROM procintel.gold.supplier_kpis\r\n",
        "ORDER BY total_awarded_usd DESC\r\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "b6b35b81",
      "displayName": "projects",
      "queryLines": [
        "-- Project-level procurement KPIs\r\n",
        "SELECT project_id, project_name, status, n_contracts,\r\n",
        "       ROUND(contracted_usd / 1e6, 1) AS contracted_usd_millions,\r\n",
        "       pct_direct_selection, median_tender_days\r\n",
        "FROM procintel.gold.project_kpis\r\n",
        "WHERE n_contracts > 0\r\n",
        "ORDER BY contracted_usd DESC;"
      ]
    },
    {
      "name": "2a893241",
      "displayName": "projects_overview",
      "queryLines": [
        "-- How many projects were approved each year, how much money, and their status\r\n",
        "SELECT year(approval_date)                       AS approval_year,\r\n",
        "       status,\r\n",
        "       COUNT(*)                                  AS n_projects,\r\n",
        "       ROUND(SUM(total_commitment_usd) / 1e9, 2) AS commitment_usd_billions\r\n",
        "FROM procintel.silver.projects\r\n",
        "WHERE approval_date IS NOT NULL AND year(approval_date) >= 2000\r\n",
        "GROUP BY ALL\r\n",
        "ORDER BY approval_year;"
      ]
    },
    {
      "name": "29af26d4",
      "displayName": "notices_by_year",
      "queryLines": [
        "-- How procurement is advertised: notice types per year\r\n",
        "-- CASE groups the many notice types into 4 readable buckets\r\n",
        "SELECT year(notice_date) AS notice_year,\r\n",
        "       CASE\r\n",
        "         WHEN notice_type ILIKE '%Invitation for Bids%'        THEN 'Invitation for Bids'\r\n",
        "         WHEN notice_type ILIKE '%Expression of Interest%'     THEN 'Request for EOI'\r\n",
        "         WHEN notice_type ILIKE '%Contract Award%'             THEN 'Contract Award'\r\n",
        "         ELSE 'Other'\r\n",
        "       END               AS notice_group,\r\n",
        "       COUNT(*)          AS n_notices\r\n",
        "FROM procintel.silver.notices\r\n",
        "WHERE notice_date IS NOT NULL AND year(notice_date) >= 2015\r\n",
        "GROUP BY ALL\r\n",
        "ORDER BY notice_year;"
      ]
    },
    {
      "name": "8e8aa463",
      "displayName": "documents_by_family",
      "queryLines": [
        "-- The unstructured \"why\" layer: which report types exist per year\r\n",
        "-- authority = how much we trust each type when sources disagree\r\n",
        "SELECT year(doc_date)        AS doc_year,\r\n",
        "       doc_family,\r\n",
        "       MAX(authority)        AS authority,\r\n",
        "       COUNT(*)              AS n_docs\r\n",
        "FROM procintel.silver.documents\r\n",
        "WHERE doc_family <> 'OTHER' AND doc_date IS NOT NULL AND year(doc_date) >= 2000\r\n",
        "GROUP BY ALL\r\n",
        "ORDER BY doc_year;"
      ]
    }
  ],
